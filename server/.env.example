# Expo access token - get it from https://expo.dev/settings/access-tokens
EXPO_ACCESS_TOKEN=your-expo-access-token-here

# Server port
PORT=3000

# --- Storage backend ---
# Path to your Firebase service-account key. When this file exists, all data
# (devices, Q&A threads, community posts) persists in Firestore across
# restarts. Set USE_FIRESTORE=false to force the memory-only fallback.
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
USE_FIRESTORE=true

# For cloud hosts (Render/Heroku/etc.): instead of committing the key file,
# paste the base64 of serviceAccountKey.json here. It takes priority over
# GOOGLE_APPLICATION_CREDENTIALS when set. (No file is written to disk.)
#   Linux/macOS: base64 -w0 serviceAccountKey.json
#   Windows:     certutil -encode serviceAccountKey.json out.b64
# then copy the base64 blob (drop the BEGIN/END header lines).
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- AI Answer via Hugging Face (free tier, used FIRST when set) ---
# 1. Get a free Hugging Face token: https://huggingface.co/settings/tokens
#    (a free "read" token is enough for the serverless Inference Router).
# 2. Paste it below and restart/redeploy the server.
#    When Hugging Face is unavailable, the server falls back to the web-search
#    providers below (Google Programmable Search -> DuckDuckGo -> Wikipedia).
HF_TOKEN=
# Optional: pin one model instead of the default Qwen/Qwen2.5-7B-Instruct:
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# Optional: per-call timeout in milliseconds (default 25000):
# HF_TIMEOUT_MS=25000

# --- Web-search answer fallback (used when Hugging Face has no credits / fails) ---
# 1. Create a Programmable Search Engine: https://programmablesearchengine.google.com/
#    (create -> "Search the entire web" -> copy the Search engine ID = CX)
# 2. Create a Google Cloud API key with "Custom Search API" enabled:
#    https://console.cloud.google.com/apis/credentials
# 3. Paste both below. When unset, the fallback automatically uses the
#    keyless DuckDuckGo / Wikipedia providers instead.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

