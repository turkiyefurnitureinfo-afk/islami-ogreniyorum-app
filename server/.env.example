# Expo access token - get it from https://expo.dev/settings/access-tokens
EXPO_ACCESS_TOKEN=your-expo-access-token-here

# Server port
PORT=3000

# --- Storage backend ---
# Path to your Firebase service-account key. When this file exists, all data
# (devices, Q&A threads, community posts) persists in Firestore across
# restarts. Set USE_FIRESTORE=false to force the memory-only fallback.
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
USE_FIRESTORE=true

# For cloud hosts (Render/Heroku/etc.): instead of committing the key file,
# paste the base64 of serviceAccountKey.json here. It takes priority over
# GOOGLE_APPLICATION_CREDENTIALS when set. (No file is written to disk.)
#   Linux/macOS: base64 -w0 serviceAccountKey.json
#   Windows:     certutil -encode serviceAccountKey.json out.b64
# then copy the base64 blob (drop the BEGIN/END header lines).
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Search provider: Serper.dev (Google organic results via API) ---
# Serper.dev returns the same Google organic results as Google Custom Search
# but needs only ONE key (no CX / Programmable Search Engine setup) and has a
# far more generous free tier: 2,500 credits/month.
# 1. Sign up at https://serper.dev and copy your API key.
# 2. Paste it below. When unset, the AI pipeline falls back to direct-Groq.
SERPER_API_KEY=
# (Optional) SERPER_MONTHLY_LIMIT=2500
# (Optional) SERPER_TIMEOUT_MS=8000

# --- LLM synthesis via Groq (Serper search -> Groq concise sourced answer) ---
# Groq serves an OpenAI-compatible API. Get a free API key at
# https://console.groq.com/keys
#
# Which models exist depends on your account. List yours with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Common choices:
#   qwen/qwen3.8-27b          Strong multilingual reasoning (TR + EN); solid default
#   groq/compound-mini        Fast small compound model
#   groq/compound             Bigger compound model
#   openai/gpt-oss-20b        OpenAI open-weights, fast
#   llama-3.3-70b-versatile   Great when available on your account (NOT available on all accounts)
#
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# LLM per-call timeout (ms). Default 15000.
# LLM_TIMEOUT_MS=15000

# --- Daily Serper quota safeguard ---
# serperService.js keeps an in-memory monthly counter (free plan = 2,500
# credits/month). Override with SERPER_MONTHLY_LIMIT if you upgrade your plan.
# When exhausted, search returns [] and the chat pipeline falls back to
# direct-Groq (quota-resilient, no 500s).

