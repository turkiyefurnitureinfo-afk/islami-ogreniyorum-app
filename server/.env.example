# Expo access token - get it from https://expo.dev/settings/access-tokens
EXPO_ACCESS_TOKEN=your-expo-access-token-here

# Server port
PORT=3000

# --- Storage backend ---
# Path to your Firebase service-account key. When this file exists, all data
# (devices, Q&A threads, community posts) persists in Firestore across
# restarts. Set USE_FIRESTORE=false to force the memory-only fallback.
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
USE_FIRESTORE=true

# --- AI Answer via Google Programmable Search Engine (Custom Search JSON API) ---
# 1. Create a Google Cloud API key: https://console.cloud.google.com/apis/credentials
# 2. Create a Programmable Search Engine: https://programmablesearchengine.google.com/
#    (In "Sites to search", add the Islamic sources you want included, e.g.
#     diyanet.gov.tr, islamsources.org, diyanethaber.com.tr)
# 3. Paste both values below. When unset, the built-in offline answer engine is used.
GOOGLE_API_KEY=
GOOGLE_CX=

# --- AI Answer via Google Gemini (free tier, used FIRST when set) ---
# 1. Get a free API key: https://aistudio.google.com/apikey
# 2. Paste it below and restart/redeploy the server.
#    When unset, the server falls back to Google Programmable Search
#    (GOOGLE_API_KEY + GOOGLE_CX) and finally the built-in engine.
GEMINI_API_KEY=
# Optional: pin one model instead of the automatic fallback list:
# GEMINI_MODEL=gemini-2.5-flash