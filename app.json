{
  "expo": {
    "name": "İslamı öğreniyorum",
    "slug": "islami-ogreniyorum",
    "version": "1.0.1",
    "scheme": "com.joshua.islamiogreniyorum",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#060b12"
    },
    "androidStatusBar": {
      "backgroundColor": "#060b12",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.joshua.islamiogreniyorum",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060b12"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.joshua.islamiogreniyorum",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "The app needs access to your camera to let you take photos for the community.",
        "NSPhotoLibraryUsageDescription": "The app needs access to your photos to let you share them in the community.",
        "NSLocationWhenInUseUsageDescription": "Your location is used only to calculate accurate prayer times for where you are.",
        "NSMicrophoneUsageDescription": "The microphone is used when recording videos to share with the community."
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-notifications",
        {
          "color": "#d8b56a",
          "sounds": ["./assets/sounds/notification_high.wav"],
          "android": {
            "useNextNotificationsApi": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to let you share them in the community.",
          "cameraPermission": "The app needs access to your camera to let you take photos for the community."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aafa9d62-b062-475a-9f27-4d88e0b8c6cc"
      }
    },
    "owner": "joshua93"
  }
}

