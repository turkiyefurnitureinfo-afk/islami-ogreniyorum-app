{
  "expo": {
    "name": "İslamı öğreniyorum",
    "slug": "islami-ogreniyorum",
    "version": "1.0.0",
    "scheme": "com.joshua.islamiogreniyorum",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#060b12"
    },
    "androidStatusBar": {
      "backgroundColor": "#060b12",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.joshua.islamiogreniyorum",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060b12"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.joshua.islamiogreniyorum",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "The app needs access to your camera to let you take photos for the community.",
        "NSPhotoLibraryUsageDescription": "The app needs access to your photos to let you share them in the community."
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#d8b56a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to let you share them in the community.",
          "cameraPermission": "The app needs access to your camera to let you take photos for the community."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aafa9d62-b062-475a-9f27-4d88e0b8c6cc"
      }
    },
    "owner": "joshua93"
  }
}
