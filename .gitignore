node_modules
.expo
.expo-shared
npm-debug.log*
.DS_Store

# Firebase secrets (NEVER commit these)
server/serviceAccountKey.json
*firebase-adminsdk*.json

# Android upload keystore (NEVER commit this)
*.jks
@*.jks
# Keystore passwords fetched from EAS by scripts/fetch-keystore.js (NEVER commit)
android/eas-credentials.properties

# Environment / secret files (NEVER commit these)
.env
server/.env
server/.env.*
!server/.env.example
service-account-key.json

# Build output & logs
dist/
*.log
server/build-log.txt
*.apk
server/*.log
# User-uploaded media (served by the backend, never committed)
uploads/

# Native project IS committed (bare workflow). EAS builds the committed
# android/ Gradle project directly (no cloud prebuild) — this is the exact
# project verified to compile. Keystore credentials are NOT in git:
# they live in ~/.gradle/gradle.properties (local) and EAS credentials (cloud).


# Backup / scratch files (never commit)
*.bak
render.yaml.bak
server/t-out.txt
# Temporary debug/test scripts and artifacts (e.g. .tmp-upload-test.js)
.tmp*
*.tmp
tmp-*

# EAS build log captures (debugging artifacts)
.easlogs/
eas-status.json
server/t-err.txt
dist-verify/
