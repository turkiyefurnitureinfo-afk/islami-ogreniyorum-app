node_modules
.expo
.expo-shared
npm-debug.log*
.DS_Store

# Firebase secrets (NEVER commit these)
server/serviceAccountKey.json
*firebase-adminsdk*.json

# Android upload keystore (NEVER commit this)
*.jks
@*.jks

# Environment / secret files (NEVER commit these)
.env
server/.env
server/.env.*
!server/.env.example
service-account-key.json

# Build output & logs
dist/
*.log
server/build-log.txt

# Native projects are generated fresh by EAS (continuous native generation)
# on every build. Keeping them out of git avoids stale native config that
# breaks cloud Gradle builds when node_modules versions change.
android/
ios/
# Scratch run logs
server/t-out.txt
server/t-err.txt
dist-verify/
